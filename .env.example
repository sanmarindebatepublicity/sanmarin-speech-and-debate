# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# These are read server-side only, by the functions in api/. None of them is
# ever sent to the browser.

# ─────────────────────────────────────────────────────────────
# Photo gallery (Events & Media page)
# ─────────────────────────────────────────────────────────────

# The Google Drive folder the gallery reads. This is the folder ID from the
# folder's URL: https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_GALLERY_FOLDER_ID=your_drive_folder_id_here

# The whole service-account key file, as ONE single-quoted line of JSON.
# Open the .json key Google gave you, remove the newlines, and paste it here.
# Keep the \n escape sequences inside private_key exactly as they appear.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'

# ─────────────────────────────────────────────────────────────
# Awards wall (History & Awards page)
# ─────────────────────────────────────────────────────────────

# Notion integration token for the Awards & Recognition database.
NOTION_AWARDS_API_KEY=your_notion_integration_token_here
